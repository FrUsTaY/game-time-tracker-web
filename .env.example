# Копируйте в .env.local и заполняйте по желанию.
# Ключи можно задать и через интерфейс: страница «Настройки» внутри приложения
# (сохраняются в data/settings.json на сервере, env имеет более низкий приоритет).

# RAWG.io — бесплатный ключ с https://rawg.io/apidocs
RAWG_API_KEY=

# GigaChat — ключ авторизации (client_id:secret в Base64) из кабинета разработчика
GIGA_API_KEY=

# Яндекс.Диск — OAuth-токен с доступом к Яндекс.Диску (https://oauth.yandex.ru)
YANDEX_DISK_TOKEN=

# 1 — строгая проверка TLS-сертификатов GigaChat (по умолчанию отключена,
# потому что сертификаты подписаны российским УЦ)
GIGA_TLS_STRICT=0
